# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ───────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/netra

# ── JWT ────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_hex
JWT_REFRESH_SECRET=replace_with_different_64_char_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend URL / CORS ─────────────────────────────────
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Cross-origin Next.js (3000) + API (5000): use lax (or none in production HTTPS).
# Blueprint default Strict does not send the refresh cookie on cross-site XHR.
COOKIE_SAMESITE=lax

# Prototype: public register. Set false so only admins can create users.
ALLOW_PUBLIC_REGISTER=true

# ── Encryption (AES-256-GCM; 32 bytes as 64 hex chars) ──
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_char_hex

# ── Email (optional — skipped if SMTP_HOST unset) ───────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=alerts@netra.yourdomain.com

# ── Maps & Highway Data ──────────────────────────────────
MAPBOX_SERVER_TOKEN=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# ── Location Tracking ────────────────────────────────────
LOCATION_PING_MAX_INTERVAL_SECONDS=60
LOCATION_STALE_THRESHOLD_MINUTES=5
LOCATION_RAW_RETENTION_HOURS=72

# ── AI Copilot (optional) ────────────────────────────────
ANTHROPIC_API_KEY=

# ── Monitoring (optional) ────────────────────────────────
SENTRY_DSN=

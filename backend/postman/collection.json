{
  "info": {
    "name": "NETRA API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "Readiness",
          "request": { "method": "GET", "url": "{{baseUrl}}/ready" }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.data?.accessToken) {",
                  "  pm.environment.set('accessToken', json.data.accessToken);",
                  "  pm.environment.set('tokenExpiry', Date.now() + 14 * 60 * 1000);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@netra.local\",\"password\":\"NetraDemo123!\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login driver",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data?.accessToken) pm.environment.set('accessToken', json.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"driver@netra.local\",\"password\":\"NetraDemo123!\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/auth/logout" }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        { "name": "Me", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/users/me" } },
        { "name": "Export me", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/users/me/export" } },
        { "name": "List users", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/users?page=1&limit=20" } }
      ]
    },
    {
      "name": "Fleet",
      "item": [
        { "name": "Drivers", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/drivers" } },
        { "name": "Vehicles", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/vehicles" } },
        { "name": "Assignments", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/assignments" } }
      ]
    },
    {
      "name": "Tracking",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"lat\":28.61,\"lng\":77.21,\"accuracy\":12,\"recordedAt\":\"{{$isoTimestamp}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/tracking/ping"
          }
        },
        {
          "name": "Latest",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/tracking/drivers/{{driverId}}/latest" }
        }
      ]
    },
    {
      "name": "Operations",
      "item": [
        { "name": "Shipments", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/shipments" } },
        { "name": "Corridors", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/corridors" } },
        { "name": "Hospitals nearby", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/hospitals/nearby?lat=28.61&lng=77.21&radius=50000" } },
        { "name": "Disruptions", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/disruptions" } },
        { "name": "Emergency alerts", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/emergency/alerts" } },
        { "name": "Analytics overview", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/analytics/overview" } }
      ]
    }
  ]
}
